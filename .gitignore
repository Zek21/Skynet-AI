# ===================================================================
# SOURCE-CODE TRACKABILITY (2026-07-02, fable-cleanup)
# -------------------------------------------------------------------
# The block-everything model above made actual SOURCE invisible to git:
# 398 tools/*.py and 46 core/*.py existed on disk while only ~39 were
# tracked, so agents editing core/tools/tests source saw nothing in
# `git status` (the documented "blocks-everything gotcha").
#
# This section makes SOURCE CODE (.py in tools/core/tests, .go in
# Skynet/) trackable at any depth for developer visibility only:
#   * only the four source trees are descended (NOT node_modules,
#     NOT data/, NOT vendored trees) -- see the `!<dir>/**/` lines;
#   * ONLY source extensions (.py/.go) are re-included -- *.json,
#     *.txt, *.key, *.pem, *.exe, *.png, *.db, secrets and all of
#     data/ stay blocked by the rules above (last-match-wins keeps
#     those globals in force for every non-.py/.go path);
#   * artifact subtrees inside the source dirs are re-blocked:
#     _archive_*, __pycache__, tools/**/dist, tools/**/node_modules.
# Trackability does NOT make a path public. The curated public surface is
# data/skynet_public_surface.json and tools/skynet_publish_boundary_guard.py
# enforces it through the installed pre-push hook.
# ===================================================================

# Descend into the source trees (a dir excluded by `*` above is never
# re-includable at file level unless the dir itself is re-included).
!tools/
!tools/**/
!core/
!core/**/
!tests/
!tests/**/
!Skynet/
!Skynet/**/

# Re-include ONLY source-code files inside those trees.
!tools/**/*.py
!core/**/*.py
!tests/**/*.py
!Skynet/**/*.go

# Re-block artifact / vendored / archive subtrees inside the source
# trees (defense in depth -- these must never be tracked even though
# they live under a descended source dir).
tools/_archive_*/
**/__pycache__/
tools/**/dist/
tools/**/node_modules/
tools/chrome_bridge/dist/
core/**/node_modules/
tests/**/node_modules/

# 2026-07-30 PII: the prospecting lane hardcodes REAL scraped third-party business
# e-mail addresses (424 distinct across ~300 domains: DE/AT/CH/PL/PT/IL/AE), so the
# `!tools/**/*.py` re-include above would republish GDPR-relevant personal data.
# This subtree must never be tracked. See
# data/runs/npm_publish_build_20260730/PUBLIC_REPO_PII_EXPOSURE_20260730.md
# and gate it with tools/skynet_public_release_gate.py --gate before any push.
tools/prospecting/

# AR-1221: track only the safe Fable project command and its validation record.
!.claude/
.claude/*
!.claude/commands/
.claude/commands/*
!.claude/commands/fable.md
!SKYNET_FABLE_CLI_STALE_TEST_ASSERTIONS_PROPOSAL_20260703.md

# @skynet/cli standalone public runtime bundle (Round 7).
!Skynet/cli/sync-runtime.mjs
!Skynet/cli/runtime/
!Skynet/cli/runtime/*.py
!Skynet/cli/runtime/manifest.json

