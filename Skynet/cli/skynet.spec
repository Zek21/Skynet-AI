# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller 6.21 onefile recipe for the native Skynet CLI.

Bundle inputs are generated by ``tools/skynet_build_exe.py --build`` from the
canonical CLI manifest.  The spec deliberately does not call ``collect_all``:
only registered entrypoint modules and their deterministic local import closure
enter ``hiddenimports``.  UPX is disabled to reduce avoidable executable-packer
heuristics and binary compatibility failures.
"""

import json
from pathlib import Path


ROOT = Path(SPECPATH).resolve().parents[1]
RUN_DIR = ROOT / "data" / "runs" / "skynet_exe_20260802"
MANIFEST_PATH = RUN_DIR / "lane1_bundle_manifest.json"
VERSION_PATH = RUN_DIR / "lane1_skynet_version_info.txt"

if not MANIFEST_PATH.is_file():
    raise SystemExit(
        "generated bundle manifest is missing; run "
        "python tools/skynet_build_exe.py --build"
    )

bundle = json.loads(MANIFEST_PATH.read_text(encoding="utf-8"))
if bundle.get("pyinstaller_version") != "6.21.0":
    raise SystemExit("bundle manifest was not generated for PyInstaller 6.21.0")
RELEASE_FORMAT = bundle.get("release_format")
if RELEASE_FORMAT not in {"onefile", "onedir"} or bundle.get("upx") is not False:
    raise SystemExit(
        "native release manifest must require onefile or onedir with UPX disabled"
    )

# 2026-08-03: this spec and tools/skynet_build_launcher.py both used to emit
# dist/skynet/skynet.exe, so whichever ran second silently clobbered the other -
# a rebuild here replaced the 1.9 MB Go launcher with the 10.5 MB Python runtime
# and cold start regressed 31 ms -> 367 ms with no error anywhere.
# Ownership is now exclusive: the Go launcher owns skynet.exe, PyInstaller owns
# skynet-runtime.exe. Fail loudly rather than overwrite.
_RUNTIME_NAME = "skynet-runtime"
_LAUNCHER_RESERVED = "skynet.exe"

entrypoint = ROOT / bundle["entrypoint"]
if not entrypoint.is_file():
    raise SystemExit(f"generated frozen bootstrap is missing: {entrypoint}")

datas = []
for row in bundle.get("datas", []):
    source = ROOT / row["source"]
    if not source.is_file():
        raise SystemExit(f"bundle data input is missing: {source}")
    datas.append((str(source), row["destination"]))

a = Analysis(
    [str(entrypoint)],
    pathex=[str(ROOT)],
    binaries=[],
    datas=datas,
    hiddenimports=list(bundle.get("hidden_imports", [])),
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=list(bundle.get("excluded_optional_packages", [])),
    noarchive=False,
    optimize=1,
)
pyz = PYZ(a.pure)

# onefile packs binaries+datas INTO the exe, so every run unpacks them to a temp
# dir (measured 1631 ms). onedir leaves them beside the exe and unpacks nothing.
_ONEFILE = RELEASE_FORMAT == "onefile"
_exe_payload = [a.binaries, a.datas] if _ONEFILE else []

if _RUNTIME_NAME + ".exe" == _LAUNCHER_RESERVED:
    raise SystemExit(
        "build collision: PyInstaller would overwrite the Go launcher at "
        + _LAUNCHER_RESERVED
    )

exe = EXE(
    pyz,
    a.scripts,
    *_exe_payload,
    [],
    exclude_binaries=not _ONEFILE,
    name="skynet-runtime",  # exclusive: the Go launcher owns skynet.exe
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=True,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    version=str(VERSION_PATH),
)

if not _ONEFILE:
    coll = COLLECT(
        exe,
        a.binaries,
        a.datas,
        strip=False,
        upx=False,
        upx_exclude=[],
        name="skynet",
    )
